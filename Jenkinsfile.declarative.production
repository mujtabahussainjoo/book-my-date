pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    parameters {
        booleanParam(
            name: 'RUN_SECURITY_SCANS',
            defaultValue: true,
            description: 'Run pip-audit and Trivy vulnerability/secret scans.'
        )
        booleanParam(
            name: 'RUN_SONAR',
            defaultValue: true,
            description: 'Run SonarQube analysis when SONAR_HOST_URL is configured.'
        )
        string(
            name: 'SONAR_HOST_URL',
            defaultValue: '',
            description: 'SonarQube base URL. Leave blank to skip the SonarQube stage.'
        )
        string(
            name: 'SONAR_CREDENTIALS_ID',
            defaultValue: 'sonar-token',
            description: 'Jenkins secret-text credential containing the SonarQube token.'
        )
        booleanParam(
            name: 'DEPLOY_TO_HOST',
            defaultValue: true,
            description: 'Deploy the approved release to the download server over SSH.'
        )
        string(
            name: 'DEPLOY_HOST',
            defaultValue: '',
            description: 'Hostname or IP of the release/download server. Leave blank to skip.'
        )
        string(
            name: 'DEPLOY_USER',
            defaultValue: 'deploy',
            description: 'SSH user used on the release/download server.'
        )
        string(
            name: 'DEPLOY_PATH',
            defaultValue: '',
            description: 'Absolute remote directory that holds released versions.'
        )
        string(
            name: 'DEPLOY_SSH_CREDENTIALS_ID',
            defaultValue: 'deploy-ssh-key',
            description: 'Jenkins SSH username/private-key credential id for the server.'
        )
        string(
            name: 'RELEASE_APPROVERS',
            defaultValue: '',
            description: 'Comma-separated users/groups allowed to approve. Blank means any user.'
        )
        string(
            name: 'NOTIFY_EMAIL',
            defaultValue: '',
            description: 'Comma-separated recipients for build result notifications. Blank disables email.'
        )
    }

    environment {
        VENV_DIR = '.venv-ci'
        S3_BUCKET = 'book-my-date-releases'
        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_CREDENTIALS_ID = 'aws-release'
        SONAR_SETTINGS = 'jenkins-pipeline/sonar-project.properties'
        SONAR_PROJECT_KEY = 'book-my-date'
        SONAR_GATE_TIMEOUT = '600'
        JENKINS_AGENT_IMAGE = 'book-my-date/jenkins-agent:1.0.0'
        QT_QPA_PLATFORM = 'offscreen'
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm
                script {
                    def ref = (env.TAG_NAME ?: (env.GIT_BRANCH ?: '')).tokenize('/').last()
                    env.TAG_NAME = ref.startsWith('v') ? ref : ''
                    env.RELEASE_TAG = env.TAG_NAME
                    echo "Release tag resolved: ${env.RELEASE_TAG ?: 'none (CI validation only)'}"
                }
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    echo "Building ${GIT_COMMIT:-unknown} from ${GIT_BRANCH:-detached HEAD}"
                    git rev-parse HEAD
                '''
            }
        }

        stage('Prepare Agent') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    command -v docker >/dev/null 2>&1 || {
                        echo "ERROR: Docker is required on the Jenkins controller."
                        exit 1
                    }
                    if ! docker image inspect "$JENKINS_AGENT_IMAGE" >/dev/null 2>&1; then
                        docker build \
                            --tag "$JENKINS_AGENT_IMAGE" \
                            --file jenkins-pipeline/Dockerfile.agent \
                            jenkins-pipeline
                    fi
                    docker run --rm "$JENKINS_AGENT_IMAGE" python --version
                '''
            }
        }

        stage('Dependencies') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    jenkins-pipeline/agent-run.sh <<'AGENT'
set -euo pipefail
mkdir -p artifacts junit coverage security
python3 --version
python3 -m venv --clear "$VENV_DIR"
. "$VENV_DIR/bin/activate"
python -m pip install --upgrade pip setuptools wheel
python -m pip install -r requirements.txt -r requirements-dev.txt
python -m pip check
python -m pip freeze | tee artifacts/pip-freeze.txt
AGENT
                '''
            }
        }

        stage('Code Quality') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    jenkins-pipeline/agent-run.sh <<'AGENT'
set -euo pipefail
. "$VENV_DIR/bin/activate"
python -m ruff check .
python -m compileall -q book_my_date installer launcher.py packaging
AGENT
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    jenkins-pipeline/agent-run.sh <<'AGENT'
set -euo pipefail
. "$VENV_DIR/bin/activate"
python -m pytest tests -q \
    --junitxml=junit/unit.xml \
    --cov=book_my_date \
    --cov=installer \
    --cov-report=xml:coverage/coverage.xml \
    --cov-report=term-missing
AGENT
                '''
            }
        }

        stage('Integration Tests') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    jenkins-pipeline/agent-run.sh <<'AGENT'
set -euo pipefail
. "$VENV_DIR/bin/activate"
python -m pytest \
    tests/test_wizard.py \
    tests/test_database.py \
    tests/test_reminders.py \
    -q \
    --junitxml=junit/integration.xml
AGENT
                '''
            }
        }

        stage('Security Checks') {
            when {
                expression { return params.RUN_SECURITY_SCANS }
            }
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    jenkins-pipeline/agent-run.sh <<'AGENT'
set -euo pipefail
. "$VENV_DIR/bin/activate"
command -v trivy >/dev/null 2>&1 || {
    echo "ERROR: trivy is required in the Jenkins agent image."
    exit 1
}

set +e
pip-audit -r requirements.txt 2>&1 | tee security/pip-audit.txt
AUDIT_STATUS=${PIPESTATUS[0]}
trivy fs \
    --scanners vuln,secret \
    --severity HIGH,CRITICAL \
    --ignore-unfixed \
    --exit-code 1 \
    --skip-dirs .git \
    --skip-dirs .venv-ci \
    --skip-dirs release \
    --skip-dirs packaging/build \
    --skip-dirs packaging/dist \
    --format table \
    . 2>&1 | tee security/trivy.txt
TRIVY_STATUS=${PIPESTATUS[0]}
set -e

if [ "$AUDIT_STATUS" -ne 0 ] || [ "$TRIVY_STATUS" -ne 0 ]; then
    echo "Security gate failed: pip-audit=$AUDIT_STATUS trivy=$TRIVY_STATUS"
    exit 1
fi
AGENT
                '''
            }
        }

        stage('Quality Gate') {
            when {
                expression { return params.RUN_SONAR && params.SONAR_HOST_URL?.trim() }
            }
            steps {
                withCredentials([string(
                    credentialsId: params.SONAR_CREDENTIALS_ID,
                    variable: 'SONAR_TOKEN'
                )]) {
                    withEnv(["SONAR_HOST_URL=${params.SONAR_HOST_URL}"]) {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail
                            jenkins-pipeline/agent-run.sh <<'AGENT'
set -euo pipefail
. "$VENV_DIR/bin/activate"
VERSION=$(python -c "from book_my_date.config import VERSION; print(VERSION)")
sonar-scanner \
    -Dproject.settings="$SONAR_SETTINGS" \
    -Dsonar.projectVersion="$VERSION"
python jenkins-pipeline/check-quality-gate.py
AGENT
                        '''
                    }
                }
            }
        }

        stage('Build') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    jenkins-pipeline/agent-run.sh <<'AGENT'
set -euo pipefail
. "$VENV_DIR/bin/activate"
VERSION=$(python -c "from book_my_date.config import VERSION; print(VERSION)")

if [ -n "${TAG_NAME:-}" ] && [ "v${VERSION}" != "$TAG_NAME" ]; then
    echo "ERROR: tag $TAG_NAME does not match application version v$VERSION"
    exit 1
fi

python packaging/build.py
mkdir -p release/wheels
python -m pip wheel . --no-deps --wheel-dir release/wheels

ARCHIVE=$(find release -maxdepth 1 -name '*.zip' -print -quit)
test -n "$ARCHIVE" || {
    echo "ERROR: native release archive was not created."
    exit 1
}
echo "$VERSION" > release/version.txt
(
    cd release
    sha256sum "$(basename "$ARCHIVE")" > "$(basename "$ARCHIVE").sha256"
)
echo "Built version $VERSION: $(basename "$ARCHIVE")"
AGENT
                '''
            }
        }

        stage('Publish') {
            when {
                beforeAgent true
                expression { return (env.RELEASE_TAG ?: '').startsWith('v') }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.AWS_CREDENTIALS_ID,
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        jenkins-pipeline/agent-run.sh <<'AGENT'
set -euo pipefail
VERSION=$(cat release/version.txt)
ARCHIVE=$(find release -maxdepth 1 -name '*.zip' -print -quit)
BASE=$(basename "$ARCHIVE")
DEST="s3://${S3_BUCKET}/staging/${BUILD_NUMBER}"

aws s3 cp "$ARCHIVE" "${DEST}/${BASE}"
aws s3 cp "${ARCHIVE}.sha256" "${DEST}/${BASE}.sha256"
aws s3 cp release/version.txt "${DEST}/version.txt"
aws s3 cp release/wheels/ "${DEST}/wheels/" --recursive
echo "Published staging artifact for v${VERSION} to ${DEST}"
AGENT
                    '''
                }
            }
        }

        stage('Approval') {
            when {
                beforeAgent true
                expression { return (env.RELEASE_TAG ?: '').startsWith('v') }
            }
            steps {
                timeout(time: 2, unit: 'HOURS') {
                    input(
                        message: "Deploy ${env.TAG_NAME} to production?",
                        ok: 'Deploy',
                        submitter: params.RELEASE_APPROVERS?.trim() ?: null
                    )
                }
            }
        }

        stage('Deploy') {
            when {
                beforeAgent true
                expression { return (env.RELEASE_TAG ?: '').startsWith('v') }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.AWS_CREDENTIALS_ID,
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        jenkins-pipeline/agent-run.sh <<'AGENT'
set -euo pipefail
VERSION=$(cat release/version.txt)
SRC="s3://${S3_BUCKET}/staging/${BUILD_NUMBER}/"
DEST="s3://${S3_BUCKET}/releases/${VERSION}/"

aws s3 cp "$SRC" "$DEST" --recursive
aws s3api head-object \
    --bucket "$S3_BUCKET" \
    --key "releases/${VERSION}/version.txt" >/dev/null
echo "Deployed v${VERSION} to ${DEST}"
AGENT
                    '''
                }
            }
        }

        stage('Deploy to Server') {
            when {
                beforeAgent true
                allOf {
                    expression { return (env.RELEASE_TAG ?: '').startsWith('v') }
                    expression {
                        return params.DEPLOY_TO_HOST &&
                               params.DEPLOY_HOST?.trim() &&
                               params.DEPLOY_PATH?.trim()
                    }
                }
            }
            steps {
                withEnv([
                    "DEPLOY_HOST=${params.DEPLOY_HOST}",
                    "DEPLOY_USER=${params.DEPLOY_USER}",
                    "DEPLOY_PATH=${params.DEPLOY_PATH}"
                ]) {
                    sshagent(credentials: [params.DEPLOY_SSH_CREDENTIALS_ID]) {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail
                            VERSION=$(cat release/version.txt)
                            ARCHIVE=$(find release -maxdepth 1 -name '*.zip' -print -quit)
                            BASE=$(basename "$ARCHIVE")
                            REMOTE_ROOT="${DEPLOY_PATH%/}"
                            REMOTE_VERSION="${REMOTE_ROOT}/${VERSION}"
                            TARGET="${DEPLOY_USER}@${DEPLOY_HOST}"

                            ssh -o StrictHostKeyChecking=accept-new "$TARGET" \
                                "mkdir -p '${REMOTE_VERSION}'"
                            scp "$ARCHIVE" "${ARCHIVE}.sha256" \
                                release/version.txt "${TARGET}:${REMOTE_VERSION}/"
                            scp -r release/wheels "${TARGET}:${REMOTE_VERSION}/"
                            ssh "$TARGET" \
                                "cd '${REMOTE_ROOT}' && ln -sfn '${VERSION}' current && \
                                 test -f 'current/${BASE}' && \
                                 grep -qx '${VERSION}' 'current/version.txt'"
                            echo "Deployed v${VERSION} to ${TARGET}:${REMOTE_VERSION} (current -> ${VERSION})"
                        '''
                    }
                }
            }
        }

        stage('Smoke Test') {
            when {
                beforeAgent true
                expression { return (env.RELEASE_TAG ?: '').startsWith('v') }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.AWS_CREDENTIALS_ID,
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        jenkins-pipeline/agent-run.sh <<'AGENT'
set -euo pipefail
VERSION=$(cat release/version.txt)
ARCHIVE=$(basename "$(find release -maxdepth 1 -name '*.zip' -print -quit)")

rm -rf smoke
mkdir smoke
cd smoke
aws s3 cp "s3://${S3_BUCKET}/releases/${VERSION}/${ARCHIVE}" .
aws s3 cp "s3://${S3_BUCKET}/releases/${VERSION}/${ARCHIVE}.sha256" .
sha256sum -c "${ARCHIVE}.sha256"

unzip -q "$ARCHIVE"
BIN=$(find . -type f -name 'BookMyDate' -perm -u+x | head -n 1)
test -n "$BIN" || {
    echo "ERROR: packaged BookMyDate executable was not found."
    exit 1
}
QT_QPA_PLATFORM=offscreen "$BIN" --version | tee smoke-version.txt
grep -F "Book My Date ${VERSION}" smoke-version.txt
AGENT
                    '''
                }
            }
        }

        stage('Monitoring') {
            when {
                beforeAgent true
                expression { return (env.RELEASE_TAG ?: '').startsWith('v') }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.AWS_CREDENTIALS_ID,
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        jenkins-pipeline/agent-run.sh <<'AGENT'
set -euo pipefail
VERSION=$(cat release/version.txt)
ARCHIVE=$(find release -maxdepth 1 -name '*.zip' -print -quit)
SIZE=$(wc -c < "$ARCHIVE")
NAMESPACE="BookMyDate/Release"
DIMENSIONS="Version=${VERSION},Environment=production"

aws cloudwatch put-metric-data \
    --namespace "$NAMESPACE" \
    --metric-name SmokeTestSuccess \
    --value 1 \
    --unit Count \
    --dimensions "$DIMENSIONS"
aws cloudwatch put-metric-data \
    --namespace "$NAMESPACE" \
    --metric-name ArtifactSizeBytes \
    --value "$SIZE" \
    --unit Bytes \
    --dimensions "$DIMENSIONS"

ALARMS=$(aws cloudwatch describe-alarms \
    --alarm-name-prefix book-my-date \
    --state-value ALARM \
    --query 'MetricAlarms[].AlarmName' \
    --output text)
if [ -n "$ALARMS" ]; then
    echo "CloudWatch alarms are active: $ALARMS"
    exit 1
fi
echo "CloudWatch health check passed for v${VERSION}"
AGENT
                    '''
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, keepLongStdio: true, testResults: 'junit/*.xml'
            archiveArtifacts(
                artifacts: 'release/**,artifacts/**,coverage/**,security/**,junit/**',
                allowEmptyArchive: true,
                fingerprint: true
            )
            cleanWs()
        }
        success {
            script {
                echo "Book My Date pipeline completed successfully."
                if (params.NOTIFY_EMAIL?.trim()) {
                    emailext(
                        to: params.NOTIFY_EMAIL,
                        subject: "[Jenkins] SUCCESS - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                        body: "Build ${env.BUILD_URL}\nTag: ${env.RELEASE_TAG ?: 'none'}\nCommit: ${env.GIT_COMMIT ?: 'unknown'}"
                    )
                }
            }
        }
        failure {
            script {
                echo "Book My Date pipeline failed. Inspect test, security, and Sonar reports."
                if (params.NOTIFY_EMAIL?.trim()) {
                    emailext(
                        to: params.NOTIFY_EMAIL,
                        subject: "[Jenkins] FAILURE - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                        body: "Build ${env.BUILD_URL}\nTag: ${env.RELEASE_TAG ?: 'none'}\nCommit: ${env.GIT_COMMIT ?: 'unknown'}"
                    )
                }
            }
        }
    }
}
