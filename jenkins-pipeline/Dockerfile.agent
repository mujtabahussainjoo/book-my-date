FROM python:3.12-bookworm

ARG TRIVY_VERSION=0.76.2
ARG SONAR_SCANNER_VERSION=8.4.0.16527

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        unzip \
        zip \
        libdbus-1-3 \
        libegl1 \
        libfontconfig1 \
        libgl1 \
        libxkbcommon-x11-0 \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-xinerama0 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install "awscli>=1.32,<2"

RUN set -eux; \
    TRIVY_ARCHIVE="trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz"; \
    curl -fsSL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_checksums.txt" -o /tmp/trivy-checksums.txt; \
    curl -fsSL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/${TRIVY_ARCHIVE}" -o "/tmp/${TRIVY_ARCHIVE}"; \
    grep " ${TRIVY_ARCHIVE}$" /tmp/trivy-checksums.txt | (cd /tmp && sha256sum -c -); \
    tar -xzf "/tmp/${TRIVY_ARCHIVE}" -C /usr/local/bin trivy; \
    rm -f /tmp/trivy-checksums.txt "/tmp/${TRIVY_ARCHIVE}"; \
    trivy --version

RUN set -eux; \
    curl -fsSL "https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-${SONAR_SCANNER_VERSION}-linux-x64.zip" -o /tmp/sonar-scanner.zip; \
    echo "$(curl -fsSL "https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-${SONAR_SCANNER_VERSION}-linux-x64.zip.sha256")  /tmp/sonar-scanner.zip" | sha256sum -c -; \
    unzip -q /tmp/sonar-scanner.zip -d /opt; \
    ln -s "/opt/sonar-scanner-${SONAR_SCANNER_VERSION}-linux-x64/bin/sonar-scanner" /usr/local/bin/sonar-scanner; \
    rm -f /tmp/sonar-scanner.zip; \
    sonar-scanner --version

WORKDIR /workspace
